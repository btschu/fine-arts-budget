generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  memberships     Membership[]
  expensesEntered Expense[]    @relation("EnteredBy")
  expensesUpdated Expense[]    @relation("UpdatedBy")
  yearsClosed     SchoolYear[] @relation("ClosedBy")
}

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  schoolYears SchoolYear[]
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  schoolId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model SchoolYear {
  id              String    @id @default(cuid())
  schoolId        String
  label           String
  startingBalance Decimal   @db.Decimal(10, 2)
  startedAt       DateTime  @default(now())
  closedAt        DateTime?
  closedById      String?

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  closedBy   User?            @relation("ClosedBy", fields: [closedById], references: [id])
  expenses   Expense[]
  categories BudgetCategory[]

  @@unique([schoolId, label])
  @@index([schoolId, closedAt])
}

model BudgetCategory {
  id              String   @id @default(cuid())
  schoolYearId    String
  name            String
  allocatedAmount Decimal  @db.Decimal(10, 2)
  isDefault       Boolean  @default(false)
  color           String   @default("slate")
  createdAt       DateTime @default(now())

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@unique([schoolYearId, name])
}

model Expense {
  id           String   @id @default(cuid())
  schoolYearId String
  categoryId   String?
  amount       Decimal  @db.Decimal(10, 2)
  item         String
  vendor       String
  spentAt      DateTime @default(now())
  createdAt    DateTime @default(now())

  enteredById String
  updatedById String?
  updatedAt   DateTime?

  receiptImage    Bytes?
  receiptMimeType String?

  schoolYear SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  category   BudgetCategory? @relation(fields: [categoryId], references: [id])
  enteredBy  User            @relation("EnteredBy", fields: [enteredById], references: [id])
  updatedBy  User?           @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@index([schoolYearId, spentAt])
}
